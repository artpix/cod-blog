---
// components/Header.astro
import { getSiteCopy } from '../i18n/site';
import { getMenu } from "../lib/api";
import { Astronav, MenuItems, MenuIcon, Dropdown, DropdownItems } from "astro-navbar";
import {Image} from 'astro:assets';
import localLogoImage from '../assets/images/cod_logo.png';
import {library, icon} from "@fortawesome/fontawesome-svg-core";
import {faGamepad, faSearch, faCalculator, faAnglesRight} from '@fortawesome/free-solid-svg-icons';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import {defaultLang} from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
library.add(faGamepad, faSearch, faCalculator, faAnglesRight);

const searchIcon = icon({prefix: "fas", iconName: faSearch.iconName});

const prefix = lang === defaultLang ? '' : `/${lang}`;

type MenuNode = {
    href: string;
    text: string;
    title: string;
    new: boolean;
    submenu?: MenuNode[];
};

function hrefWithLocale(slug: string | null | undefined) {
    let s = slug || '/';
    if (!s.startsWith('/')) s = '/' + s;
    const full = (prefix + s).replace(/\/{2,}/g, '/');
    return full === '' ? '/' : full;
}

// переключатель языков
const locales = ['ru','de','en'] as const;
const segments = Astro.url.pathname.split('/').filter(Boolean);
const currentIsLocale = locales.includes(segments[0] as typeof locales[number]);
function pathForLocale(to: string) {
    const base = currentIsLocale ? `/${segments.slice(1).join('/')}` : `/${segments.join('/')}`;
    if (to === defaultLang) return base || '/';
    return `/${to}${base === '/' ? '' : base}`;
}

// получаем и фильтруем меню по языку
const raw = (await getMenu()).filter(i => i.lang === lang);

// ищем корневые пункты — те, у кого parent_id отсутствует в списке id элементов
const allIds = new Set(raw.map(i => i.id));
const roots = raw.filter(i => !allIds.has(i.parent_id));

// строим дерево
function buildTree(parentId: string | number | null | undefined): MenuNode[] {
    return raw
        .filter(i => i.parent_id === parentId)
        .sort((a,b) => (a.position ?? 0) - (b.position ?? 0))
        .map(i => {
            const children = buildTree(i.id);
            const node: MenuNode = {
                href: hrefWithLocale(i.path),
                text: i.name,
                title: i.title || i.name,
                new: !!i.new,
            };
            if (children.length) node.submenu = children;
            return node;
        });
}

const mainMenu: MenuNode[] = roots
    .sort((a,b) => (a.position ?? 0) - (b.position ?? 0))
    .map(i => {
        const children = buildTree(i.id);
        return {
            href: hrefWithLocale(i.path),
            text: i.name,
            title: i.title || i.name,
            new: !!i.new,
            submenu: children
        };
    });

const copy = getSiteCopy(lang);
const t = useTranslations(lang);
---
<header id="header" class="header">
    <div class="lg:flex justify-between p-5 gap-5 mx-auto container header-inner">
        <Astronav closeOnClick>
            <div class="flex w-full lg:w-auto justify-between">
                <a class="logo" href={prefix || '/'}>
                    <div class="logo-img-wrapper">
                        <Image src={localLogoImage} alt="Фан-сайт игры Call of Dragons"/>
                    </div>
                    <div class="logo-heading">
                        <span>{copy.logo}</span>
                        <span>{copy.subtitle}</span>
                    </div>
                </a>
                <div class="block lg:hidden">
                    <MenuIcon class="w-4 h-4 text-gray-800"/>
                </div>
            </div>
            <MenuItems class="hidden lg:flex main-menu">
                <ul class="flex flex-col lg:flex-row lg:gap-5 nav nav-top">
                    {mainMenu && mainMenu.length > 0 && mainMenu.map((item) => (
                            <li class="menu-item relative">
                                {(item.submenu?.length ?? 0) > 0 ? (
                                        <Dropdown class="group">
                                            <button class="inline-flex items-center">
                                                <span>{item.text}</span>
                                                <span class="menu-item-icon-arrow">
                                                <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        fill="none"
                                                        viewBox="0 0 24 24"
                                                        stroke-width="3"
                                                        stroke="currentColor"
                                                        class="w-3 h-3 mt-0.5 group-open:rotate-180"
                                                >
                                                  <path
                                                          stroke-linecap="round"
                                                          stroke-linejoin="round"
                                                          d="M19.5 8.25l-7.5 7.5-7.5-7.5"
                                                  />
                                                </svg>
                                              </span>
                                            </button>
                                            <DropdownItems class="relative">
                                                <div class="lg:absolute bg-white top-2 lg:w-60 lg:shadow-md rounded z-20 main-menu-sub">
                                                    <ul class="main-menu-sub-ul">
                                                        {item.submenu && item.submenu.map((subItem) => (
                                                                <li class="menu-item main-menu-sub-item">
                                                                    <a
                                                                            href={subItem.href}
                                                                            class="main-menu-sub-a"
                                                                            data-astro-reload
                                                                            title={subItem.title}
                                                                    >
                                                                        <span>{subItem.text}</span> {subItem.new && (<span class="menu-item-new">{t('default.new')}</span>)}
                                                                    </a>
                                                                </li>
                                                        ))}
                                                    </ul>
                                                </div>
                                            </DropdownItems>
                                        </Dropdown>
                                ) : (
                                        <a href={item.href} title={item.title}>{item.text}</a>
                                )}
                            </li>
                    ))}
                    <li class="relative overflow-visible hidden lg:block">
                        <details class="group [&_summary::-webkit-details-marker]:hidden">
                            <summary
                                    class="flex items-center gap-2 border border-gray-200 rounded-sm px-2 py-1.5
             hover:bg-gray-100 transition cursor-pointer select-none list-none"
                            >
                                <!-- Глобус -->
                                <svg class="h-5 w-5 text-gray-700" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="10" />
                                    <path d="M2 12h20" />
                                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                                </svg>

                                <span class="uppercase text-sm">{lang}</span>

                                <!-- Стрелка -->
                                <svg
                                        class="h-4 w-4 text-gray-500 transition-transform group-open:rotate-180"
                                        fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                                </svg>
                            </summary>

                            <div class="absolute right-0 mt-1 w-24 mt-0 bg-white lg:shadow-md rounded-sm z-50 overflow-hidden">
                                {locales.map((l) => (
                                        <a
                                                href={pathForLocale(l)}
                                                class={`flex items-center justify-between px-4 py-2 text-sm hover:bg-[#e5e9f0] ${
                                                    lang === l ? 'text-red-600' : 'text-gray-700'
                                                }`}
                                        >
                                            <span>{l.toUpperCase()}</span>
                                            {lang === l && (
                                                    <svg class="h-4 w-4 text-red-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                                    </svg>
                                            )}
                                        </a>
                                ))}
                            </div>
                        </details>
                    </li>
                    <li class="menu-item"><a href="https://www.google.com/search?q=site:codguides.com%20" title="Поиск"><Fragment set:html={searchIcon.html} /></a></li>
                </ul>
            </MenuItems>
        </Astronav>
    </div>
</header>
