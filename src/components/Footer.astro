---
import {getSiteCopy} from "../i18n/site";
const today = new Date();
import { library, icon } from "@fortawesome/fontawesome-svg-core";
import {faHeart} from '@fortawesome/free-solid-svg-icons';
library.add(faHeart);
//
const DEFAULT_LOCALE = 'ru';
const { locale = DEFAULT_LOCALE } = Astro.params;
const prefix = locale === DEFAULT_LOCALE ? '' : `/${locale}`;
const heartIcon = icon({ prefix: "fas", iconName: faHeart.iconName });
const copy = getSiteCopy(locale);
---

<footer id="footer" class="footer">
    <p class="site-info">{copy.description}</p>
    <p class="site-copy">&copy; {today.getFullYear()} Call of Dragons Fun. {copy.subtitle}</p>
    <!--<p class="site-donation">-->
    <!--    <span class="fa-icon"><Fragment set:html={heartIcon.html} /></span>{copy.donation}-->
    <!--</p>-->
</footer>