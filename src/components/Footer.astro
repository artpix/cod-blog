---
import { getSiteCopy } from '../i18n/site';
import { defaultLang } from '../i18n/ui';

interface Props {
    locale?: string;
}

const today = new Date();
const { locale = defaultLang } = Astro.props;
const prefix = locale === defaultLang ? '' : `/${locale}`;
const copy = getSiteCopy(locale);

function pageHref(slug: string) {
    const path = `${prefix}/${slug}`.replace(/\/{2,}/g, '/');
    return path.startsWith('/') ? path : `/${path}`;
}
---

<footer id="footer" class="footer">
    <p class="site-info">{copy.description}</p>
    <p class="site-copy">
        &copy; {today.getFullYear()} Call of Dragons Fun. {copy.subtitle}
        <span class="site-copy__sep" aria-hidden="true">·</span>
        <a href={pageHref('privacy-policy')}>{copy.privacyPolicy}</a>
    </p>
</footer>
