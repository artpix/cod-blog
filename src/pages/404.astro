---
import PageLayout from "../layouts/PageLayout.astro";
import {SITE_DESCRIPTION} from "../consts";

export const prerender = true;
---
<PageLayout title="Ошибка 404" description={SITE_DESCRIPTION}>
    <!-- 404 -->
    <section class="flex items-center lg:h-full md:h-full sm:h-96 p-16">
        <div class="container flex flex-col items-center">
            <div class="flex flex-col gap-6 max-w-md text-center">
                <h2 class="font-extrabold text-9xl text-gray-600 dark:text-gray-300">
                    <span class="sr-only">Ошибка</span>404
                </h2>
                <p class="text-2xl md:text-3xl dark:text-gray-500">К сожалению, запрошенная страница не найдена.</p>
                <a href="/" class="px-8 py-4 text-xl font-semibold rounded bg-red-500 text-gray-50 hover:text-gray-200">Вернуться на главную</a>
            </div>
        </div>
    </section>
</PageLayout>