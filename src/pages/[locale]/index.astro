---
// src/pages/[locale]/index.astro
import PageLayout from "../../layouts/PageLayout.astro";
import PostTagFilter from "../../components/PostTagFilter.jsx";
import { getPosts, getTags } from "../../lib/api";
import { getAssetURL } from "../../lib/directus";
import { getSiteCopy } from "../../i18n/site";
import { getLangFromUrl } from '../../i18n/utils';
import { getNonDefaultLocalePaths } from "../../lib/locale-paths";

export const prerender = true;
export async function getStaticPaths() {
    return getNonDefaultLocalePaths();
}

const lang = getLangFromUrl(Astro.url);

const tags = (await getTags()).filter(tag => tag.lang === lang);
const copy = getSiteCopy(lang);

const posts = (await getPosts(lang)).map(p => ({
    ...p,
    image_url: p.image ? getAssetURL(p.image) : null,
}));
---
<PageLayout title={copy.title} description={copy.description} lang={lang} showAds={true} showBanner={true}>
    <PostTagFilter client:load posts={posts} tags={tags} locale={lang} />
</PageLayout>