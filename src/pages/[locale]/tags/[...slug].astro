---
import PageLayout from "../../../layouts/PageLayout.astro";
import CardPost from "../../../components/CardPost.astro";
import {getPostsByTag, getTags} from "../../../lib/api";
import { rewriteLegacyCmsHtml } from "../../../lib/rewriteLegacyCmsHtml";
import { getLangFromUrl } from '../../../i18n/utils';
import { defaultLang } from "../../../i18n/ui";
const lang = getLangFromUrl(Astro.url) || defaultLang;

const tagSlug = Astro.params.slug;
// tags
const tags = await getTags();
// Находим нужный язык
let tag = tags.find(t => t.slug === tagSlug && t.lang === lang);
// Если не нашли, тогда русский
if (!tag) {
    tag = tags.find(t => t.slug === tagSlug && t.lang === 'ru');
}
const posts = await getPostsByTag(tagSlug, lang);
---
<PageLayout title={tag.name} description={tag.description}>
    <section>
        <div class="prose mb-6">
            <div class="title">
                <h1>{tag.name}</h1>
            </div>
            <div class="content text-sm" set:html={rewriteLegacyCmsHtml(tag.body)}></div>
        </div>
        <section class="posts">
            <ul class="grid lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2 gap-5">
                {posts?.map((post) => {
                    return (
                            <CardPost
                                    id={post.id}
                                    lang={post.lang}
                                    slug={post.slug}
                                    image={post.image}
                                    title={post.title}
                                    date_created={post.date_created}
                                    tags={post.tags}
                            />
                    );
                })}
            </ul>
        </section>
    </section>
</PageLayout>