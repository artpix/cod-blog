---
import PageLayout from "../../layouts/PageLayout.astro";
import { getHeroPairings } from "../../lib/api";
import HeroPairingsFilter from "../../components/HeroPairingsFilter.jsx";
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { defaultLang } from "../../i18n/ui";
const lang = getLangFromUrl(Astro.url) || defaultLang;
import seoData from '../../i18n/pages/hero-pairings.json';

const heroPairings = await getHeroPairings();
export const prerender = false;
const copy = seoData[lang] ?? seoData['ru'];
const t = useTranslations(lang);
---
<PageLayout title={copy.title} description={copy.description} lang={lang}>
    <HeroPairingsFilter client:load heroPairings={heroPairings} lang={lang} />
    <!-- SEO-текст -->
    <section class="content-text text-sm mt-10">
        <h1 class="text-xl">{copy.h1}</h1>
        {copy.h1paragraphs.map((p) => <p>{p}</p>)}
        <h4>{copy.h4}</h4>
        {copy.h4paragraphs.map((p) => <p>{p}</p>)}
    </section>
</PageLayout>